<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <appSettings>
        <!-- Puerto donde escucha el receptor ADMS; el reloj se configura con la IP de esta
             máquina y ESTE puerto (Menú > Red > Conf. Srvr. de Nube). -->
        <add key="PuertoAdms" value="8081" />
    </appSettings>
    <connectionStrings>
        <!-- Fuente única de la cadena para el servicio (clase ADIGGM.CapaDatos.Conexion), mismo
             esquema que WSCorreos. Mantener alineada con la app principal. ⚠ credencial heredada
             pendiente de rotar (ver CONTEXTO-REFACTOR §10). -->
        <add name="TransporteAdiggm" connectionString="Initial Catalog=TransporteAdiggm;Data Source=ADIGGM.granjasmarinas.hn;Persist Security Info=True;User ID=sa;Password=ADIGGM*2016+" providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
