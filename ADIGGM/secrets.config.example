<?xml version="1.0" encoding="utf-8"?>
<!-- PLANTILLA de secretos. Copiar a 'secrets.config' (gitignored) y rellenar con valores REALES.   -->
<!-- 'secrets.config' sobreescribe las claves vacías del App.config (appSettings file="secrets.config"). -->
<!-- Al desplegar, copiar secrets.config junto a ADIGGM.exe.                                          -->
<appSettings>
  <add key="TwilioAccountSid" value="" />
  <add key="TwilioAuthToken" value="" />
  <add key="ReportServerUsuario" value="" />
  <add key="ReportServerClave" value="" />
  <add key="ReportServerDominio" value="" />
  <add key="SmtpUsuario" value="" />
  <add key="SmtpClave" value="" />
  <add key="SmtpEdoCtaUsuario" value="" />
  <add key="SmtpEdoCtaClave" value="" />
</appSettings>
