    </connectionStrings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
    <applicationSettings>
        <ADIGGM.Properties.Settings>
            <setting name="FuenteContDgv" serializeAs="String">
                <value>Century, 8.25pt</value>
            </setting>
            <setting name="FuenteTituloDgv" serializeAs="String">
                <value>Century, 8.25pt, style=Bold</value>
            </setting>
            <setting name="SeleccionarDgv" serializeAs="String">
                <value>195, 216, 247</value>
            </setting>
            <setting name="ColorFuenteDgv" serializeAs="String">
                <value>ActiveCaptionText</value>
            </setting>
        </ADIGGM.Properties.Settings>
    </applicationSettings>
