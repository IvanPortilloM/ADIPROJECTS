    <connectionStrings>
        <add name="ADIGGM.Properties.Settings.TransporteAdiggmConnectionString" connectionString="Data Source=ADIGGM;Initial Catalog=TransporteAdiggm;Persist Security Info=True;User ID=sa;Password=ADIGGM*2016+;Application Name=TransporteAdiggm" providerName="System.Data.SqlClient"/>
        <add name="ADIGGM.Properties.Settings.adiggmhn_SACConnectionString" connectionString="server=adiggm.hn;user id=adiggmhn_sa;database=adiggmhn_SAC;password=ADIGGM*2016+;persistsecurityinfo=True" providerName="MySql.Data.MySqlClient"/>
        <add name="ADIGGM.Properties.Settings.PresupuestoConn" connectionString="Data Source=ADIGGM;Initial Catalog=Presupuesto;Persist Security Info=True;User ID=sa;Password=ADIGGM*2016+" providerName="System.Data.SqlClient"/>
