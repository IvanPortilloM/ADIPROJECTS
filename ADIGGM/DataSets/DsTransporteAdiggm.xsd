            <SelectCommand>
              <DbCommand CommandType="Text" ModifiedByUser="true">
                <CommandText>SELECT CASE 
WHEN TR_Clientes.PagaISV = 'True' AND TR_TipoVehiculos.PagaISV = 'True' 
	THEN 'True'
WHEN TR_Clientes.PagaISV = 'False' AND TR_TipoVehiculos.PagaISV = 'True'
	THEN 'False'
WHEN TR_Clientes.PagaISV = 'True' AND TR_TipoVehiculos.PagaISV = 'False' 
	THEN 'False'
WHEN TR_Clientes.PagaISV = 'False' AND TR_TipoVehiculos.PagaISV = 'False'
	THEN 'False'
END AS PagaISV

FROM TR_TipoVehiculos
CROSS JOIN TR_Clientes
WHERE (IdTipoVehiculo = @IdTipoVehiculo)
AND (IdCliente = @IdCliente)</CommandText>
