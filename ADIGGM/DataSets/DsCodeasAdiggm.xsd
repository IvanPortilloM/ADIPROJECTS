                    <CommandText>SELECT        TR_CierreClientes.IdCierre, TR_CierreClientes.IdCliente, TR_Cierres.FechaInicio, TR_Cierres.FechaFin, SUM(TR_CierreClientes.SubTotalCierre) AS SubTotalCierre, SUM(TR_CierreClientes.ISVCierre) AS ISVCierre, 
